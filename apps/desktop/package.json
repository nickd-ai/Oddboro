{
  "name": "@oddboro/desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "shell": "ODDBORO_SERVER_URL=${ODDBORO_SERVER_URL:-http://127.0.0.1:4500} tauri dev",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "release": "node scripts/release.ts",
    "installer": "node scripts/installer.ts",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test \"test/*.test.ts\" && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "check-types": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --check && prettier --check . --ignore-path ../../.prettierignore --ignore-path .gitignore"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "sentry": "0.45.0"
  }
}
