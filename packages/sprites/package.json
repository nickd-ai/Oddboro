{
  "name": "@oddboro/sprites",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./load": "./src/load.ts",
    "./px": "./src/px.ts",
    "./png": "./src/png.ts",
    "./atlas.json": "./dist/atlas.json",
    "./atlas.png": "./dist/atlas.png",
    "./meta.json": "./dist/meta.json",
    "./dist/*": "./dist/*",
    "./look": "./src/look.ts",
    "./mark": "./src/mark.ts",
    "./art": "./src/art.ts"
  },
  "scripts": {
    "build": "node scripts/compile.ts && node scripts/looks-sheet.ts",
    "preview": "node scripts/compile.ts --only",
    "check-types": "tsc -p tsconfig.json",
    "lint": "prettier --check . --ignore-path ../../.prettierignore",
    "looks:derive": "node scripts/derive-looks.ts",
    "mark": "node scripts/mark.ts"
  }
}
